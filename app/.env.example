# SQLite by default. Swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Optional: set this to switch the mock generator for a real provider.
# See lib/generate.ts for the swap-in point.
# VIDEO_GEN_PROVIDER="veo"
# VIDEO_GEN_API_KEY=""
