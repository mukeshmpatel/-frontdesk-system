model InventoryUsageLedger {
  id              String             @id @default(uuid()) @db.Uuid
  propertyId      String             @map("property_id") @db.Uuid
  inventoryItemId String             @map("inventory_item_id") @db.Uuid
  taskId          String?            @map("task_id") @db.Uuid
  roomId          String?            @map("room_id") @db.Uuid
  correlationId   String             @map("correlation_id") @db.Uuid
  quantityDelta   Int                @map("quantity_delta")
  balanceAfter    Int                @map("balance_after")
  reason          String             @db.VarChar(160)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  property        Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  inventoryItem   HotelInventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  task            InternalTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  room            Room?              @relation(fields: [roomId], references: [id], onDelete: SetNull)

  @@unique([taskId, inventoryItemId])
  @@index([propertyId, createdAt(sort: Desc), correlationId])
  @@map("inventory_usage_ledger")
}

model VendorPurchaseOrder {
  id              String              @id @default(uuid()) @db.Uuid
