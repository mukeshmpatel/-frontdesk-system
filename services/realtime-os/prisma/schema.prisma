  corporateCut     Decimal            @map("corporate_cut") @db.Decimal(12, 2)
  marketingCut     Decimal            @map("marketing_cut") @db.Decimal(12, 2)
  franchiseeNet    Decimal            @map("franchisee_net") @db.Decimal(12, 2)
