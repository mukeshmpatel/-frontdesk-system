  tenantId         String                 @map("tenant_id") @db.Uuid
  propertyId       String                 @map("property_id") @db.Uuid
  sku              String                 @db.VarChar(50)
  name             String                 @db.VarChar(100)
  category         String                 @db.VarChar(50)
  unit             InventoryUnit          @default(EACH)
  currentQuantity  Int                    @map("current_quantity")
  reorderThreshold Int                    @map("reorder_threshold")
  targetQuantity   Int                    @map("target_quantity")
  unitCost         Decimal                @map("unit_cost") @db.Decimal(12, 2)
  vendorSku        String?                @map("vendor_sku") @db.VarChar(80)
  active           Boolean                @default(true)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
